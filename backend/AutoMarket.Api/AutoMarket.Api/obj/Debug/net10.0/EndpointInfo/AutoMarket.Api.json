            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "year": {
            "maximum": 2100,
            "minimum": 1900,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "mileage": {
